# --- App ---
APP_NAME=rag-multidoc-system
APP_ENV=local
# Never set this to true anywhere reachable by others: FastAPI/Starlette's
# debug mode returns full stack traces (file paths, source lines) in the
# HTTP response body on unhandled errors.
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
# These defaults are fine for a local-only deployment (the compose file
# binds db's port to 127.0.0.1, not the public network). Rotate them before
# deploying anywhere else reachable.
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@db:5432/rag_db

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- AI Provider (OpenAI-compatible) ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Chunking ---
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --- RAG retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.5

# --- File storage ---
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Security ---
# Required in any deployment reachable from the internet: protects the
# upload/query endpoints (which trigger paid OpenAI calls) from abuse.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients must send it as: X-API-Key: <value>
API_KEY=
# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty to disable CORS entirely (safe default for a server-to-server API).
CORS_ORIGINS=
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_QUERY=20/minute
# Blanket per-IP cap applied to every request (including failed-auth ones,
# which never reach the two limits above).
BLANKET_RATE_LIMIT_PER_MINUTE=100
